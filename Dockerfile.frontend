# Build stage
FROM node:20-alpine AS build

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source files
COPY apps/port-operations-frontend ./apps/port-operations-frontend
COPY tsconfig.base.json ./

# Build the React app with Vite
WORKDIR /app/apps/port-operations-frontend
RUN npx vite build

# Production stage
FROM nginx:alpine

# Copy built files
COPY --from=build /app/apps/port-operations-frontend/dist /usr/share/nginx/html

# Copy nginx configuration
COPY apps/port-operations-frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
